<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 全部画刷用 x:Shared="false" 会导致 DynamicResource 失效，故保持共享；
         ThemeManager.Apply() 直接修改这些画刷的 Color 实现即时切换 -->

    <SolidColorBrush x:Key="AccentBrush" Color="#FF6C0C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFF6C0C"/>
    <SolidColorBrush x:Key="WarmBrush" Color="#0C8CFF"/>

    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="CanvasTopBrush" Color="#262626"/>
    <SolidColorBrush x:Key="CanvasBottomBrush" Color="#141414"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEAEAE"/>
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3A"/>

    <!-- 固定色，不随明暗切换 -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF6C0C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TableGridBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="SlideSurfaceBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#30A46C"/>

    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{Binding Source={StaticResource CanvasTopBrush}, Path=Color}" Offset="0"/>
        <GradientStop Color="{Binding Source={StaticResource CanvasBottomBrush}, Path=Color}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
