<Window x:Class="ManimbleWin.Views.PresenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="演讲者视图" Height="760" Width="1280" MinHeight="520" MinWidth="920"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：当前页静帧（大） -->
        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBlock Text="当前页静帧未就绪（尚未渲染或未连接引擎）"
                           Foreground="#7A7A7A" FontSize="14" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasCurrentImage, Converter={StaticResource InvBoolToVis}}"/>
                <Image Source="{Binding CurrentImage, Converter={StaticResource PathToImage}}" Stretch="Uniform"
                       Visibility="{Binding HasCurrentImage, Converter={StaticResource BoolToVis}}"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                        Background="#CC000000" CornerRadius="3" Padding="8,4">
                    <TextBlock Text="{Binding CurrentLabel}" Foreground="#E8E8E8" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- 右：下一页静帧 + 备注 + 计时器 -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="下一页静帧未就绪"
                               Foreground="#7A7A7A" FontSize="13" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNextImage, Converter={StaticResource InvBoolToVis}}"/>
                    <Image Source="{Binding NextImage, Converter={StaticResource PathToImage}}" Stretch="Uniform"
                           Visibility="{Binding HasNextImage, Converter={StaticResource BoolToVis}}"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                            Background="#CC000000" CornerRadius="3" Padding="6,3">
                        <TextBlock Text="{Binding NextLabel}" Foreground="#DDDDDD" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#0F0F0F" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="演讲备注（本页）" Foreground="#8A8A8A" FontSize="11" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" Text="{Binding CurrentNotes, Mode=OneWay}" IsReadOnly="True"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="0" FontSize="13" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="计时" Foreground="#8A8A8A" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ElapsedText}" Foreground="#FF6C0C" FontSize="22"
                                   FontFamily="Consolas" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolTextButton}" Height="28" Padding="10,2"
                                Command="{Binding ToggleTimerCommand}">
                            <TextBlock Text="{Binding TimerButtonText}" Foreground="#DDDDDD" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource ToolTextButton}" Height="28" Padding="10,2" Margin="6,0,0,0"
                                Command="{Binding ResetTimerCommand}">
                            <TextBlock Text="重置" Foreground="#DDDDDD" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：翻页与状态 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#161616" BorderThickness="0,1,0,0"
                BorderBrush="#2A2A2A" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="上一页（←）" Command="{Binding PrevCommand}">
                        <TextBlock Text="◀" FontSize="14" Foreground="#DDDDDD"/>
                    </Button>
                    <TextBlock Text="{Binding PositionText}" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="13"
                               Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="下一页（→）" Command="{Binding NextCommand}">
                        <TextBlock Text="▶" FontSize="14" Foreground="#DDDDDD"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ESC 关闭" Foreground="#6E6E6E" FontSize="11"
                           Margin="18,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#8A8A8A" FontSize="11"
                           Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
