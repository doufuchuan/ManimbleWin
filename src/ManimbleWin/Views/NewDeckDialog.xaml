<Window x:Class="ManimbleWin.Views.NewDeckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建演示文稿" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">
    <!--
        新建演示文稿：保存位置 + 名称 + 主题（真实色板）。
        这个窗口只做输入与校验，不写盘 —— 生成文件仍然只由 NewDeckService.Create 一处负责，
        由 MainViewModel.CreateAndOpenNewDeckAsync 在「未保存三选一」通过后再调用。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="新建演示文稿" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Grid.Row="1" Text="会生成一个项目文件夹（内含 deck/ 与 assets/），并立刻以工作副本方式打开。"
                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 保存位置 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存位置" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Column="1" Style="{StaticResource FieldInput}"
                     Text="{Binding ParentDir, UpdateSourceTrigger=PropertyChanged}" ToolTip="父目录"/>
            <Button Grid.Column="2" Content="选择…" Style="{StaticResource ToolTextButton}"
                    Height="26" Padding="10,2" Margin="8,0,0,0" Click="PickParent_Click"/>
        </Grid>

        <!-- 名称 -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FieldInput}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="演示文稿名称（也是文件夹名）"/>
        </Grid>

        <!-- 主题 -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="主题" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      Height="26" FontSize="11" ToolTip="决定 common.py 的字体与配色">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0"
                                    BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}"
                                    Background="{Binding Background, Converter={StaticResource StrBrush}}">
                                <TextBlock Text="Aa" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Text, Converter={StaticResource StrBrush}}"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 路径预览 + 错误 -->
        <StackPanel Grid.Row="5">
            <Border Style="{StaticResource Hairline}" Margin="0,2,0,10"/>
            <TextBlock Text="将创建" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding DeckPathPreview}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource ToolTextButton}" Height="28" MinWidth="84"
                        Padding="14,3" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="创建" Style="{StaticResource AccentButton}" Height="28" MinWidth="96"
                        Padding="18,3" IsDefault="True" IsEnabled="{Binding CanCreate}" Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
