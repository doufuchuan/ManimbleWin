<UserControl x:Class="ManimbleWin.Views.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <!-- 自建取色小弹层：8 个预设色 + 「无高亮」 + 可展开的 #RRGGBB 输入行。
         不用系统 ColorDialog 做第一层（要多点两次、没有预设色），也不引 WinForms（D2）。 -->
    <Border Width="168" CornerRadius="6" Padding="8"
            Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <ItemsControl ItemsSource="{Binding PickerPalette}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 当前色块：外描强调色 + 右下角小勾。两个判断共用 SwatchRing/SwatchTick 转换器，
                             比较的是"打开弹层那一刻"的快照色（PickerSnapshotColor），避免刷新时勾选乱跳。 -->
                        <Button Style="{StaticResource SwatchButton}"
                                Background="{Binding Hex, Converter={StaticResource StrBrush}}"
                                ToolTip="{Binding Name}"
                                Command="{Binding DataContext.FormatPickedColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Hex}">
                            <Button.BorderBrush>
                                <MultiBinding Converter="{StaticResource SwatchRing}">
                                    <Binding Path="Hex"/>
                                    <Binding Path="DataContext.PickerSnapshotColor" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                </MultiBinding>
                            </Button.BorderBrush>
                            <TextBlock Text="✓" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource SwatchTick}">
                                        <Binding Path="Hex"/>
                                        <Binding Path="DataContext.PickerSnapshotColor" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 只有高亮能"去掉"：字色总有当前值，没有"无颜色"这种状态 -->
                <Button x:Name="RemoveButton" Content="无高亮" Style="{StaticResource NoticeLinkButton}"
                        HorizontalAlignment="Left" Padding="4,2"
                        Command="{Binding FormatPickedColorCommand}" CommandParameter=""
                        ToolTip="移除底块（源码里的 add_background_rectangle 会被删掉）"/>
                <Button Grid.Column="1" Content="自定义…" Style="{StaticResource NoticeLinkButton}"
                        Padding="4,2" Command="{Binding FormatCustomRowToggleCommand}"
                        ToolTip="输入 #RRGGBB 色值"/>
            </Grid>

            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding IsCustomColorRowOpen, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="HexBox" Width="140" HorizontalAlignment="Left"
                         Style="{StaticResource FieldInput}" FontSize="11" Padding="4,3"
                         Text="{Binding CustomColorText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="HexBox_PreviewKeyDown"
                         ToolTip="形如 #12AB34，可以省略 #"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CustomColorError}" Foreground="{DynamicResource DangerBrush}"
                               FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="应用" Style="{StaticResource NoticePrimaryButton}"
                            Command="{Binding FormatCustomColorCommand}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
