<Window x:Class="ManimbleWin.Views.FormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插入公式" Height="480" Width="700" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LaTeX 公式" Style="{StaticResource PanelHeader}"/>
        <TextBox Grid.Row="1" x:Name="Input" Height="76" Margin="0,0,0,10"
                 Style="{StaticResource FieldInput}" FontFamily="Consolas" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 TextChanged="Input_TextChanged" KeyDown="Input_KeyDown"/>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Style="{StaticResource ToolTextButton}" Content="\frac{a}{b}" Tag="\frac{a}{b}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\sqrt{x}" Tag="\sqrt{x}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="x^{2}" Tag="x^{2}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\sum_{i=1}^{n}" Tag="\sum_{i=1}^{n} a_i" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\int_0^1" Tag="\int_0^1 f(x)\,dx" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\lim" Tag="\lim_{x\to 0}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="矩阵" Tag="\begin{pmatrix} a &amp; b \\ c &amp; d \end{pmatrix}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\vec{v}" Tag="\vec{v}" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\alpha" Tag="\alpha" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
            <Button Style="{StaticResource ToolTextButton}" Content="\pi" Tag="\pi" Click="Snippet_Click" Height="26" Padding="8,2" Margin="0,0,6,6"/>
        </WrapPanel>

        <Border Grid.Row="3" CornerRadius="6" Background="{DynamicResource CodeBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="10">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="Placeholder" Text="预览" Foreground="{DynamicResource TextSecondaryBrush}"
                           Opacity="0.45" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                           VerticalAlignment="Bottom" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="支持 amsmath / amssymb 语法，使用本机 LaTeX 排版（TinyTeX / TeX Live / MiKTeX）"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolTextButton}" Content="取消" Height="28" Padding="14,3"
                        Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button Style="{StaticResource AccentButton}" Content="插入" Height="28" Padding="18,3"
                        IsDefault="True" Click="Insert_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
