<Window x:Class="ManimbleWin.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="620" Width="780"
        MinHeight="500" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- intro -->
            <RowDefinition Height="*"/>      <!-- dependency list -->
            <RowDefinition Height="Auto"/>   <!-- progress -->
            <RowDefinition Height="150"/>    <!-- logs -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,18,24,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="7" Background="#FF6C0C" Margin="0,0,12,0">
                        <TextBlock Text="M" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="ManimbleWin · 真实 Manim 引擎与 LaTeX 公式渲染"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Intro -->
        <Border Grid.Row="1" Padding="24,12,24,10">
            <TextBlock Text="Manimble 需要一个 Python 环境来运行 Manim 引擎。下方显示各项依赖的检测结果；缺失项可一键安装或按指引手动安装。"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- Dependency list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
            <ItemsControl ItemsSource="{Binding Dependencies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SubtleBackgroundBrush}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}"
                                Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- state glyph -->
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                        Background="{Binding StateColor, Converter={StaticResource StrBrush}}" Margin="0,2,12,0">
                                    <TextBlock Text="{Binding StateGlyph}" Foreground="White" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource ChromeBackgroundBrush}">
                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                       Foreground="{Binding StateColor, Converter={StaticResource StrBrush}}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Required}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource WarmBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- actions -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="安装 / 修复" Padding="10,5" FontSize="11"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding DataContext.InstallEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <Button Content="说明" Padding="10,3" FontSize="10" Margin="0,4,0,0"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding InstallUrl}"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- progress -->
        <Border Grid.Row="3" Padding="24,2" >
            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
        </Border>

        <!-- logs -->
        <Border Grid.Row="4" Margin="24,0,24,8" Background="{DynamicResource CodeBackgroundBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,6,10,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
                    <TextBlock Text="安装日志" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="10,6">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Message}" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{Binding IsError, Converter={StaticResource BoolToBrush}, ConverterParameter=err}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- footer -->
        <Border Grid.Row="5" Padding="24,10,24,16" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SeparatorBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="重新检测" Margin="14,0,0,0" Padding="10,5" FontSize="11"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding InstallEnabled}"/>
                    <Button Content="补装 LaTeX 宏包" Margin="8,0,0,0" Padding="10,5" FontSize="11"
                            Command="{Binding InstallTexPackagesCommand}" IsEnabled="{Binding InstallEnabled}"/>
                    <CheckBox Content="用清华镜像加速 pip" Style="{StaticResource ThemedCheckBox}" Margin="14,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding UseMirror}" IsEnabled="{Binding InstallEnabled}"
                              ToolTip="国内网络访问 PyPI 常常超时；取消后直接使用官方源（安装失败时会自动互相回退）"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding ContinueText}" Padding="16,7" FontSize="12"
                            Style="{StaticResource AccentButton}" Command="{Binding ContinueCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
