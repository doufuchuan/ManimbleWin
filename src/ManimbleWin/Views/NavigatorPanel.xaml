<UserControl x:Class="ManimbleWin.Views.NavigatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}">
    <UserControl.Resources>
        <!-- Navigator 中单个幻灯片缩略图（含其 build） -->
        <DataTemplate x:Key="SlideItemTemplate">
            <StackPanel Margin="0,2,0,10">
                <!-- 幻灯片缩略图 -->
                <Border BorderThickness="2" CornerRadius="3" Cursor="Hand"
                        MouseLeftButtonUp="SlideThumb_Click" Tag="{Binding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Height="84">
                        <Grid.Background>
                            <SolidColorBrush Color="{Binding Source={StaticResource SlideSurfaceBrush}, Path=Color}"/>
                        </Grid.Background>
                        <!-- 迷你内容预览：用主题文字色的标题 -->
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border VerticalAlignment="Bottom" Height="12" Background="#000000" Opacity="0.25"/>
                        <TextBlock Text="{Binding Number}" Foreground="#DDDDDD" FontSize="9"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                Background="#000000AA" CornerRadius="2" Padding="3,1"
                                Visibility="{Binding Hidden, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="隐藏" Foreground="#FF6C0C" FontSize="8"/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0"
                                Background="#E5484D" CornerRadius="2" Padding="3,1"
                                Visibility="{Binding Error, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="错误" Foreground="White" FontSize="8"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Build 缩略图列表 -->
                <ItemsControl ItemsSource="{Binding Builds}" Margin="20,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="2" Margin="0,1,0,1" Padding="0"
                                    BorderBrush="{DynamicResource SeparatorBrush}" Cursor="Hand"
                                    MouseLeftButtonUp="BuildThumb_Click" Tag="{Binding}">
                                <Grid Height="32" Background="{DynamicResource ChromeBackgroundBrush}">
                                    <TextBlock Text="构建" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,10,10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
            <Grid>
                <TextBlock Text="导航器" Style="{StaticResource PanelHeader}" Margin="0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource ToolIconButton}" Width="24" Height="24"
                        HorizontalAlignment="Right" ToolTip="新建幻灯片"
                        Command="{Binding DataContext.ToolbarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="NewSlide">
                    <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" x:Name="SlideList" ItemsSource="{Binding Slides}"
                 ItemTemplate="{StaticResource SlideItemTemplate}"
                 SelectedItem="{Binding CurrentSlide, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Padding="8,6,8,6">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
