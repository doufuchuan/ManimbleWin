<UserControl x:Class="ManimbleWin.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CodeBackgroundBrush}">
    <!-- 只有输出区：提示符与输入行就是输出流的最后一行，点任意位置即可输入 -->
    <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,8"
                  MouseDown="OutputScroll_MouseDown" Background="Transparent">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Terminal.Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground, Converter={StaticResource StrBrush}}"
                                   FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                                   FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 当前输入行：无边框，直接接在输出下面（类似 VSCode 集成终端） -->
            <Grid Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Terminal.PromptText}" Foreground="#33FF66" FontFamily="Consolas"
                           FontSize="11.5" VerticalAlignment="Top" Margin="0,0,6,0"/>
                <TextBox x:Name="InputBox" Grid.Column="1" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="0"
                         FontFamily="Consolas" FontSize="11.5" CaretBrush="#33FF66"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         Text="{Binding Terminal.Input, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="InputBox_KeyDown"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
