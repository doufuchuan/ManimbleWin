<UserControl x:Class="ManimbleWin.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 终端工具条 -->
        <Border Grid.Row="0" Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolIconButton}" Width="26" Height="22" ToolTip="新建终端" Command="{Binding MenuCommand}" CommandParameter="NewTerminal">
                    <Path Data="{StaticResource Icon.Plus}" Stroke="#CCCCCC" StrokeThickness="1.6" Stretch="Uniform" Width="11" Height="11"/>
                </Button>
                <TextBlock Text="bash — Manimble 终端" Foreground="#7A7A7A" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 终端输出（可交互历史） -->
        <ScrollViewer x:Name="OutputScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
            <ItemsControl ItemsSource="{Binding Terminal.Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground, Converter={StaticResource StrBrush}}"
                                   FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                                   FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 输入行 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="➜  " Foreground="#33FF66" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox x:Name="InputBox" Grid.Column="1" Background="Transparent" Foreground="#DDDDDD" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11.5" CaretBrush="#33FF66"
                         Text="{Binding Terminal.Input, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="InputBox_KeyDown"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
