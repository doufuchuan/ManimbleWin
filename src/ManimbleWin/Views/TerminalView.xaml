<UserControl x:Class="ManimbleWin.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 终端工具条 -->
        <Border Grid.Row="0" Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolIconButton}" Width="26" Height="22" ToolTip="New terminal" Command="{Binding MenuCommand}" CommandParameter="NewTerminal">
                    <Path Data="{StaticResource Icon.Plus}" Stroke="#CCCCCC" StrokeThickness="1.6" Stretch="Uniform" Width="11" Height="11"/>
                </Button>
                <TextBlock Text="bash — Manimble terminal" Foreground="#7A7A7A" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 终端输出（模拟一次 AI agent 构建幻灯片的会话） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
            <StackPanel>
                <TextBlock Foreground="#33FF66" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="➜  hello/deck "/><Run Text="git status --short" Foreground="#DDDDDD"/>
                </TextBlock>
                <TextBlock Foreground="#8A8A8A" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8">
                    <Run Text=" M slides.py"/>
                </TextBlock>

                <TextBlock Foreground="#33FF66" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="➜  hello/deck "/><Run Text="claude" Foreground="#DDDDDD"/>
                </TextBlock>
                <TextBlock Foreground="#C8C8C8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">
                    <Run Text="&gt; Add an animated bar chart to the Results slide, using the deck accent color." Foreground="#7EC6FF"/>
                </TextBlock>
                <TextBlock Foreground="#9A9A9A" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" LineHeight="15">
                    <Run Text="● Reading slides.py, common.py …&#x0a;"/>
                    <Run Text="● Editing class Results.construct() …&#x0a;"/>
                    <Run Text="● Writing source patch (12 lines)&#x0a;"/>
                    <Run Text="● Verifying render … " Foreground="#9A9A9A"/>
                    <Run Text="done" Foreground="#33FF66"/>
                </TextBlock>
                <TextBlock Foreground="#6A6A6A" FontFamily="Consolas" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="Changes appear on the canvas within seconds — edit by hand at the same time."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- 输入框 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="8,6">
            <TextBox Background="Transparent" Foreground="#DDDDDD" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"
                     Text="➜  " CaretBrush="#33FF66"/>
        </Border>
    </Grid>
</UserControl>
