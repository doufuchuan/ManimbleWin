<Window x:Class="ManimbleWin.Views.PythonPlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Python 图表" Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromeBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="用 matplotlib 画图，运行后图片会落到当前幻灯片。选中图片对象时运行会覆盖原图（不会叠加）。"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="CodeBox"
                 FontFamily="Consolas" FontSize="12.5"
                 AcceptsReturn="True" AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource BarBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                 Padding="8"/>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="#FF6B6B"
                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource AccentButton}" Content="运行" Width="96" Command="{Binding RunCommand}"/>
            <Button Style="{StaticResource ToolTextButton}" Content="关闭" Width="80" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
