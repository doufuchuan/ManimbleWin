<UserControl x:Class="ManimbleWin.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ManimbleWin.Helpers"
             xmlns:models="clr-namespace:ManimbleWin.Models"
             x:Name="Root"
             Background="{DynamicResource CanvasTopBrush}"
             MouseLeftButtonDown="CanvasBG_Click">

    <UserControl.Resources>
        <!-- 网格画刷 -->
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource SeparatorBrush}" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 对象选中框（装饰） -->
        <Style x:Key="ObjectSelectionChrome" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 文本对象 -->
        <DataTemplate x:Key="TextObjectTemplate">
            <Border Style="{StaticResource ObjectSelectionChrome}" Padding="1" Cursor="Hand"
                    MouseLeftButtonDown="Object_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up"
                    Tag="{Binding}" Background="Transparent">
                <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Brush}"
                           FontSize="{Binding FontSize}" FontFamily="{Binding FontFamilyName}"
                           FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                           FontStyle="{Binding Italic, Converter={StaticResource BoolToFontStyle}}"
                           TextDecorations="{Binding Underline, Converter={StaticResource BoolToTextDecorations}}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </Border>
        </DataTemplate>

        <!-- 公式对象：有真实 LaTeX 渲染图时显示 PNG，否则显示源码占位 -->
        <DataTemplate x:Key="TexObjectTemplate">
            <Border Style="{StaticResource ObjectSelectionChrome}" Padding="1" Cursor="Hand"
                    MouseLeftButtonDown="Object_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up"
                    Tag="{Binding}" Background="Transparent">
                <Grid>
                    <Image Source="{Binding SpritePath, Converter={StaticResource PathToImage}}"
                           Stretch="Uniform" IsHitTestVisible="False"
                           Visibility="{Binding HasSprite, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Brush}"
                               FontSize="{Binding FontSize}" FontFamily="Cambria Math" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasSprite, Converter={StaticResource InvBoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 形状对象（矩形/圆/箭头/线） -->
        <DataTemplate x:Key="ShapeObjectTemplate">
            <Border Style="{StaticResource ObjectSelectionChrome}" Padding="0" Cursor="Hand"
                    MouseLeftButtonDown="Object_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up"
                    Tag="{Binding}" Background="Transparent">
                <Grid>
                    <!-- 矩形 / 圆（线、箭头不显示外框） -->
                    <Border BorderBrush="{Binding Brush}" BorderThickness="3" Background="Transparent"
                            IsHitTestVisible="False"
                            Visibility="{Binding ShapeLabel, Converter={StaticResource BoxShapeVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShapeLabel}" Value="Circle">
                                        <Setter Property="CornerRadius" Value="1000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShapeLabel}" Value="Ellipse">
                                        <Setter Property="CornerRadius" Value="1000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- 线 -->
                    <Line X1="0" Y1="0" X2="{Binding Width, Converter={StaticResource PassThrough}}" Y2="0"
                          Stroke="{Binding Brush}" StrokeThickness="3" IsHitTestVisible="False"
                          VerticalAlignment="Center"
                          Visibility="{Binding ShapeLabel, Converter={StaticResource LineShapeVisibility}}"/>
                    <!-- 箭头：线 + 箭头尖 -->
                    <Line X1="0" Y1="0" X2="{Binding Width, Converter={StaticResource PassThrough}}" Y2="0"
                          Stroke="{Binding Brush}" StrokeThickness="3" IsHitTestVisible="False"
                          VerticalAlignment="Center"
                          Visibility="{Binding ShapeLabel, Converter={StaticResource ArrowShapeVisibility}}"/>
                    <Path Data="M0,-5 L12,0 L0,5 Z" Stretch="None" Fill="{Binding Brush}"
                          Stroke="{Binding Brush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,-2,0"
                          Visibility="{Binding ShapeLabel, Converter={StaticResource ArrowShapeVisibility}}"
                          IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 图片对象：有真实图片时显示缩略图，否则回退到图标+文件名 -->
        <DataTemplate x:Key="ImageObjectTemplate">
            <Border Style="{StaticResource ObjectSelectionChrome}" BorderThickness="1.5" Cursor="Hand"
                    MouseLeftButtonDown="Object_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up"
                    Tag="{Binding}" Background="#20FFFFFF" BorderBrush="{DynamicResource TableGridBrush}">
                <Grid IsHitTestVisible="False">
                    <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                           Stretch="Uniform" IsHitTestVisible="False"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                    <Grid Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}">
                        <Path Data="{StaticResource Icon.Image}" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ImageLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 表格对象 -->
        <DataTemplate x:Key="TableObjectTemplate">
            <Border Style="{StaticResource ObjectSelectionChrome}" Cursor="Hand"
                    MouseLeftButtonDown="Object_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up"
                    Tag="{Binding}" Background="Transparent">
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="1" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="2" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="3" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="4" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="5" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="{Binding Brush}" BorderThickness="1"><TextBlock Text="6" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 按类型选择模板 -->
        <conv:ObjectTemplateSelector x:Key="ObjectTemplateSelector"
            TextTemplate="{StaticResource TextObjectTemplate}"
            TexTemplate="{StaticResource TexObjectTemplate}"
            ShapeTemplate="{StaticResource ShapeObjectTemplate}"
            ImageTemplate="{StaticResource ImageObjectTemplate}"
            TableTemplate="{StaticResource TableObjectTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标尺 -->
        <Grid Grid.Row="0" Height="18" Visibility="{Binding ShowRuler, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource BarBackgroundBrush}">
            <ItemsControl ItemsSource="{Binding RulerMarks}" Margin="0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Pos}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Rectangle Width="1" Height="{Binding Tick}" Fill="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 画布主体：中间是 16:9 幻灯片 -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- 画布底色：上下渐变，两端颜色必须跟着明暗主题走。
                 两个停靠点绑的是"颜色资源"（Color，值类型）而不是画刷实例的 Color 属性——画刷实例在
                 ThemeManager 里会被整体替换，按实例 Binding 的停靠点会一直停在旧颜色。
                 ⚠ 生效范围（实测，别再往注释里写反）：DynamicResource 对"已经接进可视树、有窗口祖先"
                 的元素有效；对从未挂窗口的分离态控件（new CanvasView() 直接读）不生效——WPF 的资源
                 失效通知是从窗口往下广播的。本仓只有 MainWindow.xaml 这一处实例化，运行时控件始终在
                 窗口里，所以这里保持纯声明式即可；若将来要做预览窗口，务必把预览控件挂进某个 Window
                 （或自行订阅 ThemeManager.ThemeChanged），否则切主题时预览的画布底色不会变。
                 同样地，不要在代码里给 GradientStop.Color 赋值：那会把这里的 DynamicResource 表达式
                 顶掉（ReadLocalValue 变成 Color），重新退化成需要手动同步。 -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource CanvasTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource CanvasBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 网格覆盖层 -->
            <Rectangle Fill="{StaticResource GridBrush}" IsHitTestVisible="False"
                       Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}"/>

            <!-- 幻灯片：固定 1280x720 设计坐标，用 ScaleTransform 缩放 -->
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="{Binding SlideDisplayWidth}" MaxHeight="{Binding SlideDisplayHeight}">
                <Grid x:Name="SlideSurface" Width="1280" Height="720"
                      Background="{Binding CurrentTheme.Background, Converter={StaticResource StrBrush}}"
                      MouseLeftButtonDown="SlideBG_Click" MouseMove="Object_Move" MouseLeftButtonUp="Object_Up">
                    <!-- 引擎真实渲染帧（有真实渲染时作为底层画面） -->
                    <Image x:Name="RealFrame" Stretch="Uniform" IsHitTestVisible="False"
                           Source="{Binding CurrentBuild.RenderedImage, Converter={StaticResource PathToImage}}"
                           Visibility="{Binding UseRealRender, Converter={StaticResource BoolToVis}}"/>

                    <!-- 占位符框（在_objects 之下；真实渲染时隐藏） -->
                    <ItemsControl ItemsSource="{Binding PlaceholderObjects}" IsHitTestVisible="False"
                                  Visibility="{Binding UseRealRender, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Rectangle Stroke="{DynamicResource PlaceholderBrush}" StrokeThickness="1"
                                               StrokeDashArray="4,3" Fill="Transparent"/>
                                    <TextBlock Text="单击此处添加文本" Foreground="{DynamicResource PlaceholderBrush}"
                                               FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 幻灯片中的对象 -->
                    <ItemsControl x:Name="ObjectItems" ItemsSource="{Binding CurrentObjects}"
                                  ItemTemplateSelector="{StaticResource ObjectTemplateSelector}"
                                  Visibility="{Binding ShowObjects, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <Setter Property="Canvas.ZIndex" Value="{Binding Z}"/>
                                <Setter Property="Width" Value="{Binding Width}"/>
                                <Setter Property="Height" Value="{Binding Height}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- 幻灯片区页码 -->
                    <TextBlock Text="{Binding CurrentSlide.Number}" Foreground="#66FFFFFF" FontSize="16"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,12"
                               IsHitTestVisible="False"/>

                    <!-- 批注模式的点击捕获层：只在批注模式下 Visible，收起时完全不参与命中测试。
                         它的作用是"吃掉"点击，让对象不被选中/拖动，也不让 SlideBG_Click 开始框选；
                         不用改 SlideBG_Click 的判断条件，那会把原有交互搅进来（风险 R2）。 -->
                    <Rectangle x:Name="FeedbackClickCatcher" Fill="Transparent" Cursor="Cross"
                               Visibility="{Binding Feedback.IsAnnotating, Converter={StaticResource BoolToVis}}"
                               MouseLeftButtonDown="FeedbackCatcher_Click"/>

                    <!-- 批注层：挂在 SlideSurface 内部 = 1280×720 逻辑坐标，Viewbox 缩放时不可能漂移。
                         排在对象之后 → 永远画在最上层、永不被对象遮挡（PRD FB-P0-04）。
                         ItemsPanel 是 Canvas 且没设 Background（= null）：空白处不参与命中测试，
                         点击直接穿透给下面的对象（这是"批注层不吃画布事件"的关键，别给它加背景）。 -->
                    <ItemsControl x:Name="FeedbackNotes" ItemsSource="{Binding Feedback.Notes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 一个 Border + 一个 TextBox 同时承担"显示"和"编辑"：
                                     换成 TextBlock↔TextBox 两种控件会让高度/光标/焦点来回跳。 -->
                                <Border x:Name="NoteBox" CornerRadius="4" Padding="6" Tag="{Binding}"
                                        Width="{Binding BoxWidth}" MinHeight="20"
                                        Background="{StaticResource FeedbackRedSoftBrush}"
                                        BorderBrush="{StaticResource FeedbackRedBorderBrush}"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="NoteBox_Click"
                                        MouseMove="NoteBox_Move"
                                        MouseLeftButtonUp="NoteBox_Up">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <!-- 编辑中：边框加粗到 2px（PRD §5.1） -->
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <!-- 跳转闪烁：4px → 2px，0.6 秒 -->
                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                                                    From="4" To="2" Duration="0:0:0.6"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <TextBox x:Name="NoteText"
                                                 Text="{Binding DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32"
                                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                 Foreground="{StaticResource FeedbackRedBrush}"
                                                 CaretBrush="{StaticResource FeedbackRedBrush}"
                                                 FontSize="24" FontWeight="Medium"
                                                 TextOptions.TextFormattingMode="Display"
                                                 LostKeyboardFocus="NoteText_LostFocus"
                                                 PreviewKeyDown="NoteText_PreviewKeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <!-- 没在编辑时不参与命中测试：点击落到 Border 上（单击即进编辑），
                                                         也避免只读 TextBox 抢焦点、吞掉点击。
                                                         Focusable 一起关：编辑结束时焦点会自动离开输入框，
                                                         否则它会带着焦点留在"显示态"，后续按键写进一个不再提交的草稿。 -->
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                            <Setter Property="Focusable" Value="True"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- ✕：编辑中或 hover 时出现在右上角 -->
                                        <TextBlock x:Name="CloseMark" Text="✕" FontSize="11" Opacity="0.8"
                                                   Foreground="{StaticResource FeedbackRedBrush}" Cursor="Hand"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                                   Visibility="Collapsed"
                                                   MouseLeftButtonDown="NoteClose_Click"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="CloseMark" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger SourceName="NoteBox" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseMark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <!-- 放在最后：只读时即使 hover 也不显示 ✕（点了也不会生效，不给假承诺） -->
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter TargetName="CloseMark" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 框选矩形：在空白处按下拖动时显示，只在选中判断时用到它的范围 -->
                    <Rectangle x:Name="RubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="#1AFF6C0C" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="1"
                               StrokeDashArray="4,3"/>
                </Grid>
            </Viewbox>

            <!-- 批注模式提示条：浮在画布顶部，不占布局高度、不参与命中测试 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                    Background="#CC000000" CornerRadius="10" Padding="10,4"
                    Visibility="{Binding Feedback.IsAnnotating, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
                <TextBlock Text="批注模式 · 在幻灯片上点一下写反馈 · Esc 退出" Foreground="White" FontSize="11"/>
            </Border>

            <!-- 底部提示条 -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                    Background="#000000CC" CornerRadius="14" Padding="12,6"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12"/>
            </Border>

            <!-- 忙碌胶囊：可取消（取消命令走引擎 cancel，import/export/build/编辑都能停） -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,12,0"
                    Background="{DynamicResource AccentBrush}" CornerRadius="14" Padding="12,6,6,6"
                    Visibility="{Binding BusyVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <Button Command="{Binding CancelBusyCommand}" ToolTip="取消当前作业" Margin="8,0,0,0"
                            Width="18" Height="18" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="9">
                                    <TextBlock Text="✕" FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
