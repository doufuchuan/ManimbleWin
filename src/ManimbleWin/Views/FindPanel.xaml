<UserControl x:Class="ManimbleWin.Views.FindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding Find.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">

    <UserControl.Resources>
        <!-- 选项开关：开着时用强调色描边，与 Find.swift 里「点亮的按钮」一致 -->
        <Style x:Key="FindToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 浮层挂在画布上方（右下角），不占布局空间，随时可用 Esc 收起 -->
    <Border Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
            CornerRadius="8" Padding="10,8" Width="430"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,18,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- 搜索行 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CodeBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="4" Height="26">
                    <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource CaretBrush}"
                             FontSize="12" VerticalContentAlignment="Center" Padding="6,0"
                             Text="{Binding Find.Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="查找文本（回车：下一个，Shift+回车：上一个）"
                             KeyDown="QueryBox_KeyDown"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Find.CountText}" FontSize="11" Margin="8,0,6,0"
                           VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Button Grid.Column="2" Style="{StaticResource ToolIconButton}" Width="24" Height="24"
                        Command="{Binding Find.PrevCommand}" ToolTip="上一个（Shift+Enter）">
                    <TextBlock Text="↑" FontSize="12"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource ToolIconButton}" Width="24" Height="24"
                        Command="{Binding Find.NextCommand}" ToolTip="下一个（Enter）">
                    <TextBlock Text="↓" FontSize="12"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ToolIconButton}" Width="24" Height="24" Margin="2,0,0,0"
                        Command="{Binding Find.CloseCommand}" ToolTip="关闭（Esc）">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="9" Height="9"/>
                </Button>
            </Grid>

            <!-- 选项行 -->
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <ToggleButton Style="{StaticResource FindToggle}" Content="Aa"
                              IsChecked="{Binding Find.MatchCase}" ToolTip="区分大小写"/>
                <ToggleButton Style="{StaticResource FindToggle}" Content="ab" Margin="4,0,0,0"
                              FontWeight="SemiBold" IsChecked="{Binding Find.WholeWord}" ToolTip="全词匹配"/>
                <ToggleButton Style="{StaticResource FindToggle}" Content=".*" Margin="4,0,0,0"
                              IsChecked="{Binding Find.UseRegex}" ToolTip="正则表达式（Python 语法，替换里 $1 或 \1 引用分组）"/>
                <ToggleButton Style="{StaticResource FindToggle}" Content="备注" Margin="4,0,0,0"
                              IsChecked="{Binding Find.SearchNotes}" ToolTip="同时搜索演讲者备注"/>
                <Button Style="{StaticResource ToolIconButton}" Width="Auto" Height="22" Padding="7,0" Margin="8,0,0,0"
                        Command="{Binding MenuCommand}" CommandParameter="ToggleReplaceRow"
                        ToolTip="展开 / 收起替换行">
                    <TextBlock Text="替换" FontSize="11"/>
                </Button>
            </StackPanel>

            <!-- 替换行 -->
            <Grid Margin="0,7,0,0" Visibility="{Binding Find.ReplaceOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource CodeBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="4" Height="26">
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="12" Padding="6,0"
                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource CaretBrush}"
                             VerticalContentAlignment="Center"
                             Text="{Binding Find.Replacement, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="替换为"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource ToolTextButton}" Height="26" Margin="6,0,0,0"
                        Command="{Binding Find.ReplaceOneCommand}" ToolTip="替换当前命中，并跳到下一个">
                    <TextBlock Text="替换" FontSize="11"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="26" Padding="10,4" Margin="6,0,0,0"
                        Command="{Binding Find.ReplaceAllCommand}" ToolTip="全部替换（引擎模式下是一步撤销）">
                    <TextBlock Text="全部替换" FontSize="11"/>
                </Button>
            </Grid>

            <TextBlock Text="{Binding Find.ReplaceStatus}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
