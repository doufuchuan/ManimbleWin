<Window x:Class="ManimbleWin.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding KindLabel, StringFormat='导出为 · {0}'}"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">
    <!--
        导出选项：格式说明 + 输出路径 + 该格式专属选项。
        可见性完全由 ExportDialogViewModel.ShowBuildsOption / ShowEditableOption / ShowMovieOptions 决定，
        XAML 里不再判断 kind —— 以后加格式只改 VM。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 格式 + 说明 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding KindLabel}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding KindHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 输出路径 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存到" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Column="1" Style="{StaticResource FieldInput}"
                     Text="{Binding OutPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="输出文件完整路径"/>
            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource ToolTextButton}"
                    Height="26" Padding="10,2" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>

        <!-- PPTX / Beamer：builds -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Visibility="{Binding ShowBuildsOption, Converter={StaticResource BoolToVis}}">
            <CheckBox Style="{StaticResource ThemedCheckBox}" IsChecked="{Binding Builds, Mode=TwoWay}"
                      Content="逐 build 导出（每个构建各占一页 / 一屏）"/>
            <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,8,0,0"
                      IsChecked="{Binding Editable, Mode=TwoWay}"
                      Content="文本保持可编辑（关闭则整页作为图片导出）"
                      Visibility="{Binding ShowEditableOption, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- MP4：分辨率 / 停帧 / 帧率 -->
        <Grid Grid.Row="3" Margin="0,14,0,0"
              Visibility="{Binding ShowMovieOptions, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="分辨率" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" Width="86" Height="24" FontSize="11"
                      ItemsSource="{Binding Heights}" SelectedItem="{Binding Height, Mode=TwoWay}" ToolTip="画面高度（像素）"/>
            <TextBlock Grid.Column="2" Text="停帧" FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="3" Width="72" Height="24" FontSize="11"
                      ItemsSource="{Binding HoldOptions}" SelectedItem="{Binding Hold, Mode=TwoWay}" ToolTip="每页静止时长（秒）"/>
            <TextBlock Grid.Column="4" Text="帧率" FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="5" Width="72" Height="24" FontSize="11"
                      ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps, Mode=TwoWay}" ToolTip="每秒帧数"/>
        </Grid>

        <!-- 错误 + 按钮 -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="页数多时导出会比较慢；进度会显示在画布右上角的忙碌条上，可随时取消。"
                       FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Style="{StaticResource ToolTextButton}" Height="28" MinWidth="84"
                        Padding="14,3" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="导出" Style="{StaticResource AccentButton}" Height="28" MinWidth="96"
                        Padding="18,3" IsDefault="True" IsEnabled="{Binding CanExport}" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
