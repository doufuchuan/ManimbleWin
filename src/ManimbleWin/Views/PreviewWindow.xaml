<Window x:Class="ManimbleWin.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ManimbleWin.Views"
        Title="动画预览" Height="680" Width="1180" MinHeight="440" MinWidth="760"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 16:9 舞台（内置动画播放） -->
        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="20,16,20,6">
            <Grid Width="1280" Height="720">
                <views:AnimatedStage x:Name="Stage"/>
                <MediaElement x:Name="Movie" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              MediaEnded="Movie_MediaEnded" MediaFailed="Movie_MediaFailed" Visibility="Collapsed"/>
                <Image x:Name="ClipImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Viewbox>

        <!-- 状态行 -->
        <Grid Grid.Row="1" Margin="22,0,22,4">
            <TextBlock Text="{Binding Status}" Foreground="#8A8A8A" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="内置动画播放：对象逐个淡入 / 位移 / 形变" Foreground="#5A5A5A" FontSize="11"
                       HorizontalAlignment="Right"
                       Visibility="{Binding HasRealClips, Converter={StaticResource InvBoolToVis}}"/>
        </Grid>

        <!-- 控制条 -->
        <Border Grid.Row="2" Background="#161616" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="重新开始" Command="{Binding RestartCommand}" Foreground="#DDDDDD">
                        <TextBlock Text="⏮" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="上一构建" Command="{Binding PrevCommand}" Foreground="#DDDDDD">
                        <TextBlock Text="◀" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolTextButton}" Command="{Binding PlayPauseCommand}" Height="30" Padding="12,2" Margin="4,0">
                        <TextBlock Text="{Binding PlayLabel}" Foreground="#FF6C0C" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="下一构建" Command="{Binding NextCommand}" Foreground="#DDDDDD">
                        <TextBlock Text="▶" FontSize="14"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding PositionText}" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding SlideText}" Foreground="#6E6E6E" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="16,0" Height="18"
                        IsMoveToPointEnabled="True" ToolTip="拖动跳到任意构建"/>

                <Button Grid.Column="3" Style="{StaticResource ToolTextButton}" Height="30" Padding="10,2"
                        Command="{Binding RenderRealCommand}" Margin="0,0,10,0"
                        ToolTip="调用 manim 真正渲染这一段动画（需要引擎已连接）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="12" Foreground="#0C8CFF" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding RenderRealLabel}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="4" Text="ESC 退出 · 空格 播放/暂停" Foreground="#666666" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
