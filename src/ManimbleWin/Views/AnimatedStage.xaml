<UserControl x:Class="ManimbleWin.Views.AnimatedStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- 16:9 舞台：对象由代码按帧差异动画进出，视觉上接近 manim 的 FadeIn / Create / Transform -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="Root" Width="1280" Height="720" ClipToBounds="True" Background="Black">
            <Image x:Name="FrameImage" Stretch="Uniform" Opacity="0"/>
            <Canvas x:Name="Stage" Width="1280" Height="720"/>
            <TextBlock x:Name="EmptyHint" Text="这一页还没有内容" FontSize="22"
                       Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Viewbox>
</UserControl>
