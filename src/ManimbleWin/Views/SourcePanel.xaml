<UserControl x:Class="ManimbleWin.Views.SourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CodeBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="代码" Style="{StaticResource PanelHeader}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentSlide.File}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock Text="Python" Foreground="{DynamicResource WarmBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 编辑操作条 -->
        <Border Grid.Row="1" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorBrush}" Background="{DynamicResource BarBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolTextButton}" ToolTip="应用修改并重新渲染 (Ctrl+S)"
                        Command="{Binding ApplySourceEditCommand}" Height="24" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="应用" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTextButton}" ToolTip="还原为上次保存的源码"
                        Command="{Binding RevertSourceEditCommand}" Height="24" Padding="8,2" Margin="4,0,0,0">
                    <TextBlock Text="还原" FontSize="11"/>
                </Button>
                <TextBlock Text="{Binding SourceEditStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 可编辑代码区：行号 + TextBox -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LineNumbers" Grid.Column="0" Text="{Binding SourceLineNumbers, Mode=OneWay}"
                     Background="{DynamicResource CodeBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True"
                     TextAlignment="Right" Padding="0,8,8,8" Opacity="0.7" VerticalScrollBarVisibility="Hidden"/>
            <TextBox x:Name="CodeBox" Grid.Column="1"
                     Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas" FontSize="11.5" BorderThickness="0"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" Padding="4,8,8,8"
                     KeyDown="CodeBox_KeyDown"/>
        </Grid>
    </Grid>
</UserControl>
