<UserControl x:Class="ManimbleWin.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ManimbleWin.Helpers"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12,14,16">

            <TextBlock Text="Inspector" Style="{StaticResource PanelHeader}"/>

            <!-- 无选中：显示幻灯片信息与提示 -->
            <StackPanel Visibility="{Binding SelectedObject, Converter={StaticResource InvNullToVis}}">
                <TextBlock Text="{Binding CurrentSlide.Name, StringFormat=当前幻灯片: {0}}"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,10"/>
                <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="6" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                    <StackPanel>
                        <TextBlock Text="提示" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="• 单击对象以选中" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="• 拖动可移动；按住 Shift 拖动可吸附" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="• 双击文本可重新输入" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="• 方向键可微调选中对象" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 有选中：显示对象属性 -->
            <StackPanel Visibility="{Binding SelectedObject, Converter={StaticResource NullToVis}}">
                <!-- 类型徽标 -->
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,2,0,10">
                    <TextBlock Text="{Binding SelectedObject.KindLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <!-- 内容：公式对象编辑 LaTeX 源码，其他对象编辑文本 -->
                <TextBlock Text="内容" Style="{StaticResource PanelHeader}"/>
                <TextBox Visibility="{Binding SelectedObject.Kind, Converter={StaticResource KindIsNotTex}}"
                         Text="{Binding SelectedObject.DisplayText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}" AcceptsReturn="True" Height="52" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Visibility="{Binding SelectedObject.Kind, Converter={StaticResource KindIsTex}}" Margin="0,0,0,10">
                    <TextBlock Text="LaTeX 源码" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedObject.Value, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" AcceptsReturn="True" Height="54" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,6"
                             ToolTip="例如 \frac{\pi}{2} + \sqrt{x^2}；改完自动重新排版"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="重新渲染" Command="{Binding RerenderFormulaCommand}"
                                Style="{StaticResource AccentButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                ToolTip="立即用 LaTeX 重新排版（Ctrl+Enter）"/>
                        <Button Content="编辑…" Command="{Binding EditFormulaCommand}"
                                Style="{StaticResource ToolTextButton}" Padding="10,4" FontSize="11"
                                ToolTip="打开带实时预览的公式编辑器"/>
                    </StackPanel>
                    <TextBlock Text="{Binding FormulaStatus}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 图片对象：更换图片（仅引擎连接时可用，未连给提示） -->
                <StackPanel Visibility="{Binding SelectedObject.Kind, Converter={StaticResource KindIsImage}}" Margin="0,0,0,10">
                    <Button Content="更换图片…" Command="{Binding ReplaceImageCommand}"
                            Style="{StaticResource AccentButton}" Padding="10,5" FontSize="11" HorizontalAlignment="Left"
                            ToolTip="为当前图片对象选择一张新图片（走引擎，一步撤销）"/>
                    <TextBlock Text="{Binding SelectedObject.ImageLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 外观 -->
                <TextBlock Text="外观" Style="{StaticResource PanelHeader}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="颜色" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Grid.Row="0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                        <Border Width="18" Height="18" CornerRadius="3" Background="{Binding SelectedObject.Color, Converter={StaticResource StrBrush}}" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}"/>
                        <TextBlock Text="{Binding SelectedObject.Color}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="字号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Grid.Row="1" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedObject.FontSize, StringFormat={}{0:0}}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    <TextBlock Text="字体" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Grid.Row="2" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedObject.Font}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </Grid>

                <!-- 格式开关 -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <ToggleButton Content="B" Width="28" Height="26" Margin="0,0,4,0" IsChecked="{Binding SelectedObject.Bold, Mode=TwoWay}" FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SubtleBackgroundBrush}" BorderThickness="0" Cursor="Hand"/>
                    <ToggleButton Content="I" Width="28" Height="26" Margin="0,0,4,0" IsChecked="{Binding SelectedObject.Italic, Mode=TwoWay}" FontStyle="Italic"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SubtleBackgroundBrush}" BorderThickness="0" Cursor="Hand"/>
                    <ToggleButton Width="28" Height="26" IsChecked="{Binding SelectedObject.Underline, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SubtleBackgroundBrush}" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="U" TextDecorations="Underline"/>
                    </ToggleButton>
                </StackPanel>

                <Border Style="{StaticResource Hairline}" Margin="0,2,0,10"/>

                <!-- 位置与尺寸 -->
                <TextBlock Text="位置与大小（画布像素）" Style="{StaticResource PanelHeader}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox Text="{Binding SelectedObject.X, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Margin="0,0,3,3" ToolTip="X"/>
                    <TextBox Text="{Binding SelectedObject.Y, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Grid.Column="1" Margin="3,0,0,3" ToolTip="Y"/>
                    <TextBox Text="{Binding SelectedObject.Width, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Grid.Row="1" Margin="0,3,3,3" ToolTip="宽度"/>
                    <TextBox Text="{Binding SelectedObject.Height, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}" Grid.Row="1" Grid.Column="1" Margin="3,3,0,3" ToolTip="高度"/>
                </Grid>

                <Border Style="{StaticResource Hairline}" Margin="0,2,0,10"/>

                <!-- 代码位置 -->
                <TextBlock Text="源码位置" Style="{StaticResource PanelHeader}"/>
                <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="4" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                    <TextBlock Text="{Binding SelectedObject.Loc}" Foreground="{DynamicResource WarmBrush}" FontFamily="Consolas" FontSize="11"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
