<Window x:Class="ManimbleWin.Views.ThemePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用主题" Height="560" Width="820" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="应用主题" Style="{StaticResource PanelHeader}"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="deck 当前主题："/>
                <Run Text="{Binding DeckThemeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="　本页自己的主题："/>
                <Run Text="{Binding SlideThemeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 主题清单：每行是真实色板（背景色 + 文字色 + 强调色三块色卡 + 显示名） -->
            <Border Grid.Column="0" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource SeparatorBrush}" Background="{DynamicResource CodeBackgroundBrush}">
                <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 色板：背景 / 文字 / 强调色 -->
                                <Border Grid.Column="0" Width="52" Height="26" CornerRadius="3" BorderThickness="1"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        Background="{Binding Background, Converter={StaticResource StrBrush}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Aa" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{Binding Text, Converter={StaticResource StrBrush}}"/>
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="4,0,0,0"
                                                Background="{Binding Accent, Converter={StaticResource StrBrush}}"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding ToneText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Background, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CrossesText, Mode=OneWay}" Foreground="{DynamicResource WarmBrush}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="deck" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource SubtleBackgroundBrush}" CornerRadius="3" Padding="5,1"
                                            Visibility="{Binding IsSlideTheme, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="本页" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 预览 -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6">
                    <Run Text="当前页预览："/>
                    <Run Text="{Binding SceneName, Mode=OneWay}"/>
                </TextBlock>

                <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SeparatorBrush}" Background="{DynamicResource CodeBackgroundBrush}"
                        Padding="0">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="8"/>
                        <TextBlock Text="预览" FontSize="12" Opacity="0.4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PreviewImage, Converter={StaticResource InvNullToVis}}"/>
                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        <ProgressBar Height="2" IsIndeterminate="True" VerticalAlignment="Top"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Content="仅应用到当前幻灯片" IsChecked="{Binding SlideOnly, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,6,0,0"
                              Content="跨明暗时同时互换源码里的黑白（不写 TEXT_COLOR 的文字才不会白字落浅底）"
                              IsChecked="{Binding Flip, Mode=TwoWay}"
                              Visibility="{Binding ShowFlip, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolTextButton}" Content="取消" Height="28" Padding="14,3" Margin="0,0,8,0"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button Style="{StaticResource AccentButton}" Content="应用" Height="28" Padding="20,3"
                        Command="{Binding ApplyCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
